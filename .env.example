BOT_TOKEN=your_bot_token_from_botfather
# Админы через запятую (доступ к /admin, тикеты, рассылка и т.д.)
ADMIN_IDS=8112037106,5503338424

# --- Platega (https://docs.platega.io) ---
# MERCHANT_ID: UUID мерчанта из панели Platega (Настройки → API)
# API_KEY: секретный ключ из той же панели
PLATEGA_MERCHANT_ID=
PLATEGA_API_KEY=
PLATEGA_API_URL=https://app.platega.io
# Метод оплаты: 2 = СБП/QR, 10 = CardRu (МИР), 12 = International
PLATEGA_PAYMENT_METHOD=2
# Необязательно: куда вернуть покупателя после оплаты
PLATEGA_RETURN_URL=
PLATEGA_FAILED_URL=

DATABASE_URL=sqlite+aiosqlite:///./database.db

MAIN_CHANNEL=@your_channel
SUPPORT_USERNAME=@your_support_username

# Optional: token for your PUBG Mobile ID lookup service.
PUBG_LOOKUP_TOKEN=
